{
  "expo": {
    "name": "Datebook",
    "slug": "datebook-ios",
    "version": "1.0.0",
    "scheme": "datebook",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#07070a",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sarveshjagtap.datebook",
      "buildNumber": "3",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Datebook uses Face ID to keep your calendar locked when you're not using it.",
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true,
        "NSCalendarsUsageDescription": "Datebook can keep a copy of your classes and assignments in Apple Calendar.",
        "NSCalendarsFullAccessUsageDescription": "Datebook can keep a copy of your classes and assignments in Apple Calendar.",
        "NSLocationWhenInUseUsageDescription": "Datebook uses your location for arrive-here reminders.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Datebook uses your location so arrive-here reminders can fire when Datebook is closed.",
        "UIBackgroundModes": [
          "fetch",
          "processing",
          "location"
        ]
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.sarveshjagtap.datebook"
        ]
      }
    },
    "android": {
      "package": "com.sarveshjagtap.datebook",
      "adaptiveIcon": {
        "backgroundColor": "#07070a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-quick-actions",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Datebook uses Face ID to keep your calendar locked when you're not using it."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#07070a"
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "sounds": [],
          "mode": "production"
        }
      ],
      "expo-calendar",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Datebook uses your location so arrive-here reminders can fire when Datebook is closed.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-background-fetch",
      "expo-task-manager",
      "@bacons/apple-targets",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.sarveshjagtap.datebook.widget",
                  "targetName": "DatebookWidgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.sarveshjagtap.datebook"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.sarveshjagtap.datebook.share",
                  "targetName": "DatebookShare",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.sarveshjagtap.datebook"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "a73c8ddf-228e-4527-a3bc-1193ba854c80"
      }
    },
    "owner": "sarveshvj"
  }
}
