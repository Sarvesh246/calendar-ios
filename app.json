{
  "expo": {
    "name": "Datebook",
    "slug": "datebook-ios",
    "version": "1.0.0",
    "scheme": "datebook",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#07070a",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sarveshjagtap.datebook",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Datebook uses Face ID to keep your calendar locked when you're not using it."
      }
    },
    "android": {
      "package": "com.sarveshjagtap.datebook",
      "adaptiveIcon": {
        "backgroundColor": "#07070a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-quick-actions",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Datebook uses Face ID to keep your calendar locked when you're not using it."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#07070a"
        }
      ],
      "expo-status-bar"
    ]
  }
}
