# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# env files - real values never leave the machine
.env*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# loose notes and credential dumps at the repo root (never tracked)
/*.txt

# local tool state
graphify-out/
.idea/
.vscode/*
!.vscode/extensions.json
.claude/settings.local.json
